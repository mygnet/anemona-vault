{
  "name": "anemona-vault",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.7",
  "publisher": "mygnet",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mygnet/anemona-vault.git"
  },
  "homepage": "https://github.com/mygnet/anemona-vault",
  "bugs": {
    "url": "https://github.com/mygnet/anemona-vault/issues"
  },
  "categories": [
    "Other",
    "Visualization",
    "Snippets"
  ],
  "keywords": [
    "vault",
    "notes",
    "markdown",
    "secrets",
    "password-manager",
    "passwords",
    "apikeys",
    "tokens",
    "tasks",
    "todo",
    "commands",
    "snippets",
    "developer-tools",
    "productivity",
    "knowledge-base",
    "workspace",
    "documentation",
    "developer",
    "sidebar",
    "organizer"
  ],
  "main": "./out/extension.js",
  "icon": "media/anemona-vault.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anemonaVault",
          "title": "AV",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "anemonaVault": [
        {
          "type": "webview",
          "id": "anemonaVault.view",
          "name": "%view.anemonaVault.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "anemonaVault.showNotifications",
        "title": "%command.showNotifications%"
      },
      {
        "command": "anemonaVault.selectStorageFolder",
        "title": "%command.selectStorageFolder%"
      },
      {
        "command": "anemonaVault.createNote",
        "title": "%command.createNote%"
      },
      {
        "command": "anemonaVault.createCategory",
        "title": "%command.createCategory%"
      },
      {
        "command": "anemonaVault.refresh",
        "title": "%command.refresh%",
        "icon": {
          "light": "media/refresh-light.svg",
          "dark": "media/refresh-dark.svg"
        }
      },
      {
        "command": "anemonaVault.moreActions",
        "title": "%command.moreActions%",
        "icon": {
          "light": "media/more-light.svg",
          "dark": "media/more-dark.svg"
        }
      },
      {
        "command": "anemonaVault.deleteNote",
        "title": "%command.deleteNote%"
      },
      {
        "command": "anemonaVault.search",
        "title": "%command.search%",
        "icon": {
          "light": "media/search-light.svg",
          "dark": "media/search-dark.svg"
        }
      },
      {
        "command": "anemonaVault.exportVault",
        "title": "%command.exportVault%"
      },
      {
        "command": "anemonaVault.importVault",
        "title": "%command.importVault%"
      },
      {
        "command": "anemonaVault.recentFolders",
        "title": "%command.recentFolders%"
      },
      {
        "command": "anemonaVault.rebuildScheduledEventsCache",
        "title": "%command.rebuildScheduledEventsCache%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "anemonaVault.search",
          "when": "view == anemonaVault.view",
          "group": "navigation@1"
        },
        {
          "command": "anemonaVault.refresh",
          "when": "view == anemonaVault.view",
          "group": "navigation@2"
        },
        {
          "command": "anemonaVault.moreActions",
          "when": "view == anemonaVault.view",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "anemona-vault.storagePath": {
          "type": "string",
          "default": "",
          "description": "%config.storagePath.description%"
        },
        "anemona-vault.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifications.enabled.description%"
        },
        "anemona-vault.notifications.checkIntervalMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "%config.notifications.checkIntervalMinutes.description%"
        },
        "anemona-vault.notifications.dueSoonHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "%config.notifications.dueSoonHours.description%"
        },
        "anemona-vault.notifications.tickIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "%config.notifications.tickIntervalSeconds.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "vite build --config webview/vite.config.ts",
    "dev:webview": "vite --config webview/vite.config.ts",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0"
  }
}